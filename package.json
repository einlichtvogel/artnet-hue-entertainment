{
  "name": "artnet-hue-entertainment",
  "version": "2.0.0",
  "description": "Near-realtime ArtNet control over Signify/Philips Hue lights using the new Hue Entertainment API",
  "repository": {
    "type": "git",
    "url": "https://github.com/einlichtvogel/artnet-hue-entertainment.git"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('build', {recursive: true, force: true})\"",
    "build": "tsc -p tsconfig.json",
    "postbuild": "node -e \"require('node:fs').chmodSync('build/cli.js', 0o755)\"",
    "test": "npm run build && node --test test/*.test.js",
    "check": "npm run build && node --test test/*.test.js",
    "prepack": "npm run build"
  },
  "author": {
    "name": "Jeffrey Kog",
    "url": "https://github.com/jeffreykog"
  },
  "license": "MIT",
  "homepage": "https://github.com/einlichtvogel/artnet-hue-entertainment",
  "bugs": {
    "url": "https://github.com/einlichtvogel/artnet-hue-entertainment/issues"
  },
  "bin": {
    "artnet-hue-entertainment": "./build/cli.js"
  },
  "files": [
    "build/",
    "docs/",
    "README.md",
    "LICENSE.txt"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "artnet",
    "dmx",
    "philips",
    "hue",
    "entertainment",
    "light"
  ],
  "dependencies": {
    "@nodertc/dtls": "^0.6.0",
    "artnet-protocol": "^0.2.1",
    "axios": "^1.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  }
}
